{
  "compilerOptions": {
    "target": "ESNext",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["bun"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "jsxImportSource": "asku-jsx",
    "paths": {
      "asku-jsx/jsx-runtime": ["./ui/jsx-runtime.ts"],
      "asku-jsx/jsx-dev-runtime": ["./ui/jsx-runtime.ts"]
    }
  },
  "include": ["api", "shared", "ui", "test", "build.ts"]
}
