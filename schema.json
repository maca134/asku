{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asku.dev/schema.json",
  "title": "asku plaintext payloads",
  "description": "Plaintext inside the encrypted envelope. dir=q carries a Question, dir=a carries an Answer.",
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$" },
    "markdown": { "type": "string", "maxLength": 65536 },
    "option": {
      "description": "A bare string is shorthand for {value: s, label: s}.",
      "oneOf": [
        { "type": "string", "minLength": 1, "maxLength": 200 },
        {
          "type": "object",
          "required": ["value"],
          "additionalProperties": false,
          "properties": {
            "value": { "type": "string", "minLength": 1, "maxLength": 200 },
            "label": { "type": "string", "maxLength": 200 },
            "md": { "$ref": "#/$defs/markdown" }
          }
        }
      ]
    },
    "other": {
      "type": "boolean",
      "description": "Adds an \"Other\" option with a text box. A write-in comes back as a plain value; a default matching no option pre-fills the box."
    },
    "item": {
      "type": "object",
      "required": ["id", "type", "label"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "enum": ["confirm", "single", "multi", "review", "text", "number"] },
        "label": { "type": "string", "minLength": 1, "maxLength": 500 },
        "md": { "$ref": "#/$defs/markdown", "description": "Per-question markdown context." },
        "required": { "type": "boolean" }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "confirm" } } },
          "then": {
            "properties": {
              "id": true,
              "type": true,
              "label": true,
              "md": true,
              "required": true,
              "default": { "type": "boolean" }
            },
            "additionalProperties": false
          }
        },
        {
          "if": { "properties": { "type": { "const": "single" } } },
          "then": {
            "required": ["options"],
            "properties": {
              "id": true,
              "type": true,
              "label": true,
              "md": true,
              "required": true,
              "options": { "type": "array", "items": { "$ref": "#/$defs/option" }, "minItems": 1, "maxItems": 100 },
              "default": { "type": "string" },
              "other": { "$ref": "#/$defs/other" }
            },
            "additionalProperties": false
          }
        },
        {
          "if": { "properties": { "type": { "const": "multi" } } },
          "then": {
            "required": ["options"],
            "properties": {
              "id": true,
              "type": true,
              "label": true,
              "md": true,
              "required": true,
              "options": { "type": "array", "items": { "$ref": "#/$defs/option" }, "minItems": 1, "maxItems": 100 },
              "default": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
              "min": { "type": "integer", "minimum": 0 },
              "max": { "type": "integer", "minimum": 1 },
              "other": { "$ref": "#/$defs/other" }
            },
            "additionalProperties": false
          }
        },
        {
          "if": { "properties": { "type": { "const": "review" } } },
          "then": {
            "description": "Approve or reject each option. Answered as a map of option value to boolean; undecided options are left out.",
            "required": ["options"],
            "properties": {
              "id": true,
              "type": true,
              "label": true,
              "md": true,
              "required": true,
              "options": { "type": "array", "items": { "$ref": "#/$defs/option" }, "minItems": 1, "maxItems": 100 }
            },
            "additionalProperties": false
          }
        },
        {
          "if": { "properties": { "type": { "const": "text" } } },
          "then": {
            "properties": {
              "id": true,
              "type": true,
              "label": true,
              "md": true,
              "required": true,
              "default": { "type": "string" },
              "placeholder": { "type": "string", "maxLength": 200 },
              "multiline": { "type": "boolean" },
              "maxLength": { "type": "integer", "minimum": 1 }
            },
            "additionalProperties": false
          }
        },
        {
          "if": { "properties": { "type": { "const": "number" } } },
          "then": {
            "properties": {
              "id": true,
              "type": true,
              "label": true,
              "md": true,
              "required": true,
              "default": { "type": "number" },
              "min": { "type": "number" },
              "max": { "type": "number" },
              "step": { "type": "number", "exclusiveMinimum": 0 }
            },
            "additionalProperties": false
          }
        }
      ]
    },
    "question": {
      "type": "object",
      "required": ["questions"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string", "maxLength": 200 },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60,
          "description": "Names the session: shown in the browser tab and the page's top bar. A later batch can change it."
        },
        "md": { "$ref": "#/$defs/markdown", "description": "Markdown context shown above all questions." },
        "questions": { "type": "array", "items": { "$ref": "#/$defs/item" }, "minItems": 1, "maxItems": 50 },
        "deadline": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400,
          "description": "Seconds the user has to answer. After that the page locks the batch and the client returns a timeout answer."
        },
        "sent": {
          "type": "integer",
          "minimum": 0,
          "description": "Unix seconds when the batch was asked. Added by the client when there is a deadline."
        },
        "mood": {
          "enum": ["confident", "excited", "nervous", "begging", "grumpy", "sheepish"],
          "description": "How the agent feels about asking. Changes the form's look."
        }
      }
    },
    "say": {
      "description": "A one-way status update from the agent, shown in the page's feed. Never answered.",
      "type": "object",
      "required": ["say"],
      "additionalProperties": false,
      "properties": {
        "say": { "type": "string", "minLength": 1, "maxLength": 10000 }
      }
    },
    "answer": {
      "type": "object",
      "required": ["answers"],
      "additionalProperties": false,
      "properties": {
        "answers": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/id" },
          "additionalProperties": {
            "description": "confirm: boolean, single/text: string, multi: string[], number: number, review: {value: boolean}.",
            "type": ["boolean", "string", "number", "array", "object"],
            "items": { "type": "string" },
            "additionalProperties": { "type": "boolean" }
          }
        },
        "skipped": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
        "comments": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/id" },
          "additionalProperties": { "type": "string", "maxLength": 10000 }
        },
        "note": { "type": "string", "maxLength": 10000 },
        "delegated": {
          "type": "array",
          "items": { "$ref": "#/$defs/id" },
          "uniqueItems": true,
          "description": "Questions the user left to the agent to decide."
        },
        "timeout": {
          "type": "boolean",
          "description": "Set by the client when the deadline passed without an answer."
        },
        "error": {
          "type": "string",
          "maxLength": 2000,
          "description": "Set by the browser when it could not show the question, e.g. it failed schema validation."
        }
      }
    },
    "opening": {
      "description": "Answer 0 of a session the user started on the website: their message to the agent that joins.",
      "type": "object",
      "required": ["note"],
      "additionalProperties": false,
      "properties": {
        "note": { "type": "string", "maxLength": 10000 }
      }
    }
  }
}
