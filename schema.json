{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asku.dev/schema.json",
  "title": "asku plaintext payloads",
  "description": "Plaintext inside the encrypted envelope. dir=q carries a Question, dir=a carries an Answer, dir=m a Message.",
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$" },
    "markdown": { "type": "string", "maxLength": 65536 },
    "option": {
      "description": "A bare string is shorthand for {value: s, label: s}.",
      "oneOf": [
        { "type": "string", "minLength": 1, "maxLength": 200 },
        {
          "type": "object",
          "required": ["value"],
          "additionalProperties": false,
          "properties": {
            "value": { "type": "string", "minLength": 1, "maxLength": 200 },
            "label": { "type": "string", "maxLength": 200 },
            "md": { "$ref": "#/$defs/markdown" }
          }
        }
      ]
    },
    "day": { "type": "string", "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$" },
    "minute": {
      "type": "string",
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])T([01]\\d|2[0-3]):[0-5]\\d$"
    },
    "other": {
      "type": "boolean",
      "description": "Adds an \"Other\" option with a text box. A write-in comes back as a plain value; a default matching no option pre-fills the box."
    },
    "when": {
      "type": "object",
      "description": "Show this question only when an earlier question in the same batch has this answer: true/false for confirm, an option value for single, and for multi, an option value it contains. Hidden questions are never required and come back in skipped.",
      "required": ["id", "is"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "is": { "type": ["boolean", "string"], "minLength": 1, "maxLength": 200 }
      }
    },
    "item": {
      "type": "object",
      "required": ["id", "type", "label"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "enum": ["confirm", "single", "multi", "review", "rank", "text", "number", "date"] },
        "label": { "type": "string", "minLength": 1, "maxLength": 500 },
        "md": { "$ref": "#/$defs/markdown", "description": "Per-question markdown context." },
        "required": { "type": "boolean" },
        "when": { "$ref": "#/$defs/when" }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "confirm" } } },
          "then": {
            "properties": {
              "id": true,
              "type": true,
              "label": true,
              "md": true,
              "required": true,
              "when": true,
              "default": { "type": "boolean" }
            },
            "additionalProperties": false
          }
        },
        {
          "if": { "properties": { "type": { "const": "single" } } },
          "then": {
            "required": ["options"],
            "properties": {
              "id": true,
              "type": true,
              "label": true,
              "md": true,
              "required": true,
              "when": true,
              "options": { "type": "array", "items": { "$ref": "#/$defs/option" }, "minItems": 1, "maxItems": 100 },
              "default": { "type": "string" },
              "other": { "$ref": "#/$defs/other" }
            },
            "additionalProperties": false
          }
        },
        {
          "if": { "properties": { "type": { "const": "multi" } } },
          "then": {
            "required": ["options"],
            "properties": {
              "id": true,
              "type": true,
              "label": true,
              "md": true,
              "required": true,
              "when": true,
              "options": { "type": "array", "items": { "$ref": "#/$defs/option" }, "minItems": 1, "maxItems": 100 },
              "default": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
              "min": { "type": "integer", "minimum": 0 },
              "max": { "type": "integer", "minimum": 1 },
              "other": { "$ref": "#/$defs/other" }
            },
            "additionalProperties": false
          }
        },
        {
          "if": { "properties": { "type": { "const": "review" } } },
          "then": {
            "description": "Approve or reject each option. Answered as a map of option value to boolean; undecided options are left out.",
            "required": ["options"],
            "properties": {
              "id": true,
              "type": true,
              "label": true,
              "md": true,
              "required": true,
              "when": true,
              "options": { "type": "array", "items": { "$ref": "#/$defs/option" }, "minItems": 1, "maxItems": 100 }
            },
            "additionalProperties": false
          }
        },
        {
          "if": { "properties": { "type": { "const": "rank" } } },
          "then": {
            "description": "Put the options in order. Answered as every option value, first to last.",
            "required": ["options"],
            "properties": {
              "id": true,
              "type": true,
              "label": true,
              "md": true,
              "required": true,
              "when": true,
              "options": { "type": "array", "items": { "$ref": "#/$defs/option" }, "minItems": 1, "maxItems": 100 }
            },
            "additionalProperties": false
          }
        },
        {
          "if": { "properties": { "type": { "const": "text" } } },
          "then": {
            "properties": {
              "id": true,
              "type": true,
              "label": true,
              "md": true,
              "required": true,
              "when": true,
              "default": { "type": "string" },
              "placeholder": { "type": "string", "maxLength": 200 },
              "multiline": { "type": "boolean" },
              "maxLength": { "type": "integer", "minimum": 1 }
            },
            "additionalProperties": false
          }
        },
        {
          "if": { "properties": { "type": { "const": "number" } } },
          "then": {
            "properties": {
              "id": true,
              "type": true,
              "label": true,
              "md": true,
              "required": true,
              "when": true,
              "default": { "type": "number" },
              "min": { "type": "number" },
              "max": { "type": "number" },
              "step": { "type": "number", "exclusiveMinimum": 0 },
              "display": {
                "enum": ["stepper", "slider"],
                "description": "slider shows a range input; it needs min and max. Still answered as a number."
              }
            },
            "additionalProperties": false,
            "if": { "required": ["display"], "properties": { "display": { "const": "slider" } } },
            "then": { "required": ["min", "max"] }
          }
        },
        {
          "if": { "properties": { "type": { "const": "date" } } },
          "then": {
            "description": "A date from the native picker. min/max/default have no offset and are read as the user's local time. Answered as YYYY-MM-DD, or YYYY-MM-DDTHH:mm±hh:mm with time: true.",
            "properties": {
              "id": true,
              "type": true,
              "label": true,
              "md": true,
              "required": true,
              "when": true,
              "time": { "type": "boolean" },
              "default": true,
              "min": true,
              "max": true
            },
            "additionalProperties": false,
            "if": { "required": ["time"], "properties": { "time": { "const": true } } },
            "then": {
              "properties": {
                "default": { "$ref": "#/$defs/minute" },
                "min": { "$ref": "#/$defs/minute" },
                "max": { "$ref": "#/$defs/minute" }
              }
            },
            "else": {
              "properties": {
                "default": { "$ref": "#/$defs/day" },
                "min": { "$ref": "#/$defs/day" },
                "max": { "$ref": "#/$defs/day" }
              }
            }
          }
        }
      ]
    },
    "question": {
      "type": "object",
      "required": ["questions"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string", "maxLength": 200 },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60,
          "description": "Names the session: shown in the browser tab and the page's top bar. A later batch can change it."
        },
        "md": { "$ref": "#/$defs/markdown", "description": "Markdown context shown above all questions." },
        "questions": { "type": "array", "items": { "$ref": "#/$defs/item" }, "minItems": 1, "maxItems": 50 },
        "deadline": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400,
          "description": "Seconds the user has to answer. After that the page locks the batch and the client returns a timeout answer."
        },
        "sent": {
          "type": "integer",
          "minimum": 0,
          "description": "Unix seconds when the batch was asked. Added by the client when there is a deadline."
        },
        "mood": {
          "enum": ["confident", "excited", "nervous", "begging", "grumpy", "sheepish"],
          "description": "How the agent feels about asking. Changes the form's look."
        }
      }
    },
    "say": {
      "description": "A one-way status update from the agent, shown in the page's feed. Never answered.",
      "type": "object",
      "required": ["say"],
      "additionalProperties": false,
      "properties": {
        "say": { "type": "string", "minLength": 1, "maxLength": 10000 },
        "progress": {
          "description": "Makes the update a progress bar, labelled by say. A later update with the same say moves that bar instead of adding a line. done must not exceed total: the page ignores an update where it does.",
          "type": "object",
          "required": ["done", "total"],
          "additionalProperties": false,
          "properties": {
            "done": { "type": "integer", "minimum": 0 },
            "total": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "message": {
      "description": "dir=m: the user writing to the agent outside any form, or pressing STOP. The client prints it on the agent's next call.",
      "type": "object",
      "minProperties": 1,
      "maxProperties": 1,
      "additionalProperties": false,
      "properties": {
        "message": { "type": "string", "minLength": 1, "maxLength": 10000 },
        "stop": { "const": true, "description": "Stop working and confirm with the user." }
      }
    },
    "answer": {
      "type": "object",
      "required": ["answers"],
      "additionalProperties": false,
      "properties": {
        "answers": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/id" },
          "additionalProperties": {
            "description": "confirm: boolean, single/text: string, multi/rank: string[], number: number, date: string, review: {value: boolean}.",
            "type": ["boolean", "string", "number", "array", "object"],
            "items": { "type": "string" },
            "additionalProperties": { "type": "boolean" }
          }
        },
        "skipped": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
        "comments": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/id" },
          "additionalProperties": { "type": "string", "maxLength": 10000 }
        },
        "note": { "type": "string", "maxLength": 10000 },
        "delegated": {
          "type": "array",
          "items": { "$ref": "#/$defs/id" },
          "uniqueItems": true,
          "description": "Questions the user left to the agent to decide."
        },
        "timeout": {
          "type": "boolean",
          "description": "Set by the client when the deadline passed without an answer."
        },
        "error": {
          "type": "string",
          "maxLength": 2000,
          "description": "Set by the browser when it could not show the question, e.g. it failed schema validation."
        }
      }
    },
    "opening": {
      "description": "Answer 0 of a session the user started on the website: their message to the agent that joins.",
      "type": "object",
      "required": ["note"],
      "additionalProperties": false,
      "properties": {
        "note": { "type": "string", "maxLength": 10000 }
      }
    }
  }
}
